{"declaredTotal":27,"derivedFrom":{"path":"conformance/partner-kit/vectors.json","repo":"cX3po/pathos-dacs-ref","sections":["canonical-accept","canonical-reject"],"sha256":"f7c6d0de62b399c746c263fc9ed1f8219f156580952da7fc67f763f8cb4424a3"},"name":"pathos-dacs partner-kit conformance vectors","nonNormative":"NON-NORMATIVE sanity vectors extracted from pathos-dacs-ref. Passing them is NOT a DACS certification; the normative source is the DACS specification (KyneSys Labs / Demos Network).","v":"pathos-dacs-jcs-canonical-vectors:0.1","vectors":[{"canonicalUtf8Hex":"7b2261223a312c2262223a2268656c6c6f227d","description":"plain ASCII object","expectedSha256":"d84ab9f85753473707229d00b92623f0f9a1b8b9bf69763fc5cfc692b56c236b","id":"ca-ascii-basic","input":{"a":1,"b":"hello"},"section":"canonical-accept"},{"canonicalUtf8Hex":"7b2261223a312c2262223a2268656c6c6f227d","description":"keys supplied out of order hash identically (JCS sorts object keys)","expectedSha256":"d84ab9f85753473707229d00b92623f0f9a1b8b9bf69763fc5cfc692b56c236b","id":"ca-key-ordering","input":{"a":1,"b":"hello"},"section":"canonical-accept"},{"canonicalUtf8Hex":"7b226e616d65223a22636166c3a9227d","description":"string value: cafe with precomposed U+00E9 (NFC)","expectedSha256":"645fa443126a8954fc6d871912b8fc67bc2ee8feae417efe55546251962ca74d","id":"ca-nfc-precomposed","input":{"name":"café"},"section":"canonical-accept"},{"canonicalUtf8Hex":"7b226e616d65223a22636166c3a9227d","description":"string value: cafe as e + U+0301 (NFD) - MUST hash identically to NFC after CF-1 normalisation","expectedSha256":"645fa443126a8954fc6d871912b8fc67bc2ee8feae417efe55546251962ca74d","id":"ca-nfd-decomposed","input":{"name":"café"},"section":"canonical-accept"},{"canonicalUtf8Hex":"7b22636166c3a9223a317d","description":"object KEY in NFC form","expectedSha256":"4ba6f859a6604763e30e1afc74dd00bf3b245be58d902b5d1ae0eaa119e8a141","id":"ca-unicode-key-nfc","input":{"café":1},"section":"canonical-accept"},{"canonicalUtf8Hex":"7b2263616665cc81223a317d","description":"object KEY in NFD form - MUST NOT hash identically to the NFC key. CF-1 normalises string VALUES only; RFC 8785 preserves member names as received and sorts their raw UTF-16 code units, so NFC and NFD names are distinct members. Previously this carried sameHashAs: 'unicode-key-nfc', which encoded our own key-normalisation defect (#270).","expectedSha256":"26a86d452316c9c5fbd357205471fe96854efae9c460b0497c3b512f66172d60","id":"ca-unicode-key-nfd","input":{"café":1},"section":"canonical-accept"},{"canonicalUtf8Hex":"7b2263616665cc81223a322c22636166c3a9223a317d","description":"an object carrying BOTH the NFC and NFD spellings of the same word as member names is valid and canonicalises to TWO members, ordered by raw UTF-16 code units. This was a reject case ('nfc-key-collision') while we normalised member names — under CF-1 as written (string VALUES only) the two names never collide, so there is nothing to reject.","expectedSha256":"a2d154082182d12d601088ebd807c6aa696cd07ae4d8614ef552e6be956f9bef","id":"ca-nfc-nfd-key-pair-distinct","input":{"café":2,"café":1},"section":"canonical-accept"},{"canonicalUtf8Hex":"7b226e223a34327d","description":"integer value","expectedSha256":"4e0730f238f81de137ff27d89ec3bcc3ebadf95107661387df82043c4ec25475","id":"ca-number-integer","input":{"n":42},"section":"canonical-accept"},{"canonicalUtf8Hex":"7b226e223a393030373139393235343734303939317d","description":"Number.MAX_SAFE_INTEGER (2^53-1 = 9007199254740991) is the LARGEST accepted integer (boundary)","expectedSha256":"e1da48c6a6089f06ecb4e0a2259e658e3786b2420f52baccdf929ec6460d7b41","id":"ca-safe-int-max","input":{"n":9007199254740991},"section":"canonical-accept"},{"canonicalUtf8Hex":"7b226e223a302e357d","description":"in-range decimal value","expectedSha256":"aec38c68ae9784cd6c9391c1d52335984c2722d6ec167168b08027566480962d","id":"ca-number-decimal","input":{"n":0.5},"section":"canonical-accept"},{"canonicalUtf8Hex":"7b226e223a31652d377d","description":"small magnitude uses exponent form: 1e-7 -> \"1e-7\"","expectedSha256":"747d6d23b64d1b2d579adb832b44de31c91c875bbef7a8e397f5d183a746b54b","id":"ca-number-small-exponent","input":{"n":1e-7},"section":"canonical-accept"},{"canonicalUtf8Hex":"7b226e223a302e33303030303030303030303030303030347d","description":"shortest round-trip: 0.1+0.2 -> \"0.30000000000000004\" (not \"0.3\")","expectedSha256":"1d8a8e16d9ee625f1fb5ef505413efa212cc020b272ed0f9b3d3d81acf593fde","id":"ca-number-shortest-roundtrip","input":{"n":0.30000000000000004},"section":"canonical-accept"},{"canonicalUtf8Hex":"7b226e223a302e317d","description":"decimal 0.1 -> \"0.1\" (no trailing/leading drift)","expectedSha256":"c20c34ed16c837e86b4dcdb33f98c274c9f7da1231f64302082d2cd50743f951","id":"ca-number-decimal-tenth","input":{"n":0.1},"section":"canonical-accept"},{"canonicalUtf8Hex":"7b226e223a2d312e357d","description":"negative fractional -> \"-1.5\"","expectedSha256":"88937a1939eede07ce08e21d88358de627b6742adcaba9dc6de1bc7867414c12","id":"ca-number-negative-fraction","input":{"n":-1.5},"section":"canonical-accept"},{"canonicalUtf8Hex":"7b2273223a225c7530303031227d","description":"control char U+0001 -> lowercase \\u0001 escape","expectedSha256":"8d4f0e5fe4a5bba1edb70f8fefc66bfede576b92884d96ea3f2e58f099712594","id":"ca-string-control-char","input":{"s":"\u0001"},"section":"canonical-accept"},{"canonicalUtf8Hex":"7b2273223a22615c74625c6e63227d","description":"tab + newline use two-char escapes \\t \\n (not \\u0009)","expectedSha256":"99486c9a0bbba24d3bdd8fd5187058891418e01b79b0d68fcb95c8a0eea54be8","id":"ca-string-two-char-escapes","input":{"s":"a\tb\nc"},"section":"canonical-accept"},{"canonicalUtf8Hex":"7b2273223a22615c22625c5c63227d","description":"quote and backslash escape as \\\" and \\\\","expectedSha256":"97a1049b950c4967857a84a892616be14cfa33824839b42b557d9299074e9ea6","id":"ca-string-quote-backslash","input":{"s":"a\"b\\c"},"section":"canonical-accept"},{"canonicalUtf8Hex":"7b2273223a22f09f