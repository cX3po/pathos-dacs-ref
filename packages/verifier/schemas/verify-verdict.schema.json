{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cX3po/pathos-dacs-ref/packages/verifier/schemas/verify-verdict.schema.json",
  "title": "dacs-verifier result (pathos-dacs-verifier:1)",
  "description": "Result of verifyDocument(), POST /verify and the MCP verify_bundle tool.",
  "type": "object",
  "properties": {
    "apiVersion": { "const": "pathos-dacs-verifier:1" },
    "bundleKind": { "enum": ["v1", "legacy", "unrecognised"] },
    "exitCode": { "enum": [0, 1, 2], "description": "0 pass, 1 fail, 2 indeterminate" },
    "verdict": {
      "type": "object",
      "properties": {
        "decision": { "enum": ["pass", "fail", "indeterminate"] },
        "jobId": { "type": "string" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": { "type": "string" },
              "outcome": { "enum": ["pass", "fail", "indeterminate", "skipped"] },
              "detail": { "type": "string" }
            },
            "required": ["step", "outcome", "detail"],
            "additionalProperties": false
          }
        },
        "canonicalBundleHash": { "type": "string" },
        "signersVerified": { "type": "array", "items": { "type": "string" } },
        "attestationsVerified": { "type": "integer", "minimum": 0 },
        "attestationsFailed": { "type": "integer", "minimum": 0 }
      },
      "required": ["decision", "jobId", "steps", "canonicalBundleHash", "signersVerified", "attestationsVerified", "attestationsFailed"],
      "additionalProperties": false
    }
  },
  "required": ["apiVersion", "bundleKind", "exitCode", "verdict"],
  "additionalProperties": false
}
